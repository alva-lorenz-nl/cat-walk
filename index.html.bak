<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>喵喵狐的秘密漫步小径 · Pixel Art</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Zpix:wght@400&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      user-select: none;
      -webkit-user-select: none;
    }
    body {
      background: #141419;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      color: #f3f3f3;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      overflow: hidden;
    }
    .header {
      position: absolute;
      top: 14px;
      text-align: center;
      z-index: 10;
    }
    .title {
      font-size: 19px;
      font-weight: 700;
      letter-spacing: 2px;
      color: #eed6b1;
      text-shadow: 2px 2px 0px #24140e, -1px -1px 0px #000;
    }
    .subtitle {
      font-size: 11px;
      color: #a49e97;
      margin-top: 5px;
      letter-spacing: 0.5px;
    }
    .canvas-container {
      position: relative;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 18px 40px rgba(0,0,0,0.65), 0 0 0 3px #3c322b;
      background: #1b1a24;
    }
    canvas {
      display: block;
      image-rendering: -moz-crisp-edges;
      image-rendering: -webkit-crisp-edges;
      image-rendering: pixelated;
      image-rendering: crisp-edges;
    }
    .controls {
      position: absolute;
      bottom: 22px;
      display: flex;
      gap: 14px;
      z-index: 10;
    }
    .btn {
      background: #2b2520;
      border: 2px solid #5a4b3d;
      box-shadow: 0 4px 0 #181411;
      color: #e8dccb;
      padding: 10px 20px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.1s ease;
      touch-action: manipulation;
    }
    .btn:active {
      transform: translateY(3px);
      box-shadow: 0 1px 0 #181411;
      background: #3e332a;
    }
    .btn-scratch {
      background: #4a211e !important;
      border-color: #8f3d35 !important;
      box-shadow: 0 4px 0 #28100e !important;
      color: #ffd8d3 !important;
    }
    .btn-scratch:active {
      transform: translateY(3px);
      box-shadow: 0 1px 0 #28100e !important;
      background: #612723 !important;
    }
    .dialog-box {
      position: absolute;
      top: 50px;
      max-width: 88%;
      background: rgba(20, 18, 22, 0.94);
      border: 2px solid #d4a76a;
      box-shadow: 0 8px 24px rgba(0,0,0,0.8), inset 0 0 0 2px #3e2e1e;
      padding: 12px 18px;
      border-radius: 8px;
      font-size: 13px;
      line-height: 1.6;
      color: #f7ede2;
      text-align: center;
      transition: opacity 0.25s;
      opacity: 0;
      pointer-events: none;
    }
    .dialog-box.show {
      opacity: 1;
    }
  </style>
</head>
<body>

  <div class="header">
    <div class="title">🐾 莱顿运河畔 · 像素散步 🍂</div>
    <div class="subtitle">方向键移动，空格互动，键盘 [F] 键或点击按钮给赫尔曼一爪子！</div>
  </div>

  <div class="canvas-container">
    <canvas id="gameCanvas" width="320" height="180"></canvas>
    <div id="dialog" class="dialog-box"></div>
  </div>

  <div class="controls">
    <button class="btn" id="btnLeft">◀ 往左走</button>
    <button class="btn" id="btnAction">🌿 探头看看</button>
    <button class="btn btn-scratch" id="btnScratch">🐾 挠他！</button>
    <button class="btn" id="btnRight">往右走 ▶</button>
  </div>

  <script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');
    const dialog = document.getElementById('dialog');

    // 禁用平滑插值，保持锐利像素质感
    ctx.imageSmoothingEnabled = false;

    // 保持 16:9 像素缩放
    function resizeCanvas() {
      const maxW = Math.min(window.innerWidth - 24, 640);
      const scale = maxW / 320;
      canvas.style.width = (320 * scale) + 'px';
      canvas.style.height = (180 * scale) + 'px';
    }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    // 状态管理
    const cat = {
      x: 50,
      y: 133,
      vx: 0,
      speed: 1.3,
      facing: 1, // 1: 右, -1: 左
      step: 0,
      walkTimer: 0
    };

    const bench = {
      x: 215,
      y: 114, // 椅子往上挪，稳稳立在石台阶中央，远离水面
      w: 42,
      maxHp: 100,
      hp: 100
    };

    let scratchEffect = 0;
    let leaves = [];
    for (let i = 0; i < 16; i++) {
      leaves.push({
        x: Math.random() * 320,
        y: Math.random() * 140,
        speed: 0.3 + Math.random() * 0.4,
        sway: Math.random() * Math.PI * 2,
        color: Math.random() > 0.5 ? '#d97d27' : '#b3541e'
      });
    }

    const dialogues = [
      "赫尔曼瞥了你一眼，从深红马甲口袋里摸出一块热腾腾的华夫饼塞进你手里：『阿尔瓦那家伙又带你吹冷风了？拿着，少多嘴。』",
      "秋风卷落运河边的黄叶。赫尔曼抚平领口处微皱的绿宝石褶领巾，轻哼一声：『小猫崽子，别把爪印蹭我条纹外袍上。』",
      "阿尔瓦温和地走过来揉揉你的脑袋：『小猫今天走累了吗？要不要在长椅上靠一会儿？』"
    ];
    let dialogIndex = 0;

    const scratchDialogues = [
      "【啪嚓！】小猫飞扑上去狠抓！赫尔曼深红马甲上的纽扣崩飞了一颗！赫尔曼咬牙切齿：『阿尔瓦！管管你惯坏的小畜生！』",
      "【喵呜抓！】小猫亮爪！赫尔曼手里的图纸被划破，绿宝石领巾歪在一边：『嘶……这领巾是定制的！小猫崽子你给我松爪！』",
      "【连续猫猫拳！】赫尔曼狼狈地用厚厚的研究手稿挡住脸：『别挠了！华夫饼全给你！明天我就去找阿尔瓦算账！』",
      "阿尔瓦在一旁忍着笑，悄悄递给你一个小鱼干：『咳……好啦小猫，等下赫尔曼真要被气得冒烟了。』"
    ];
    let scratchIndex = 0;

    // 辅助像素矩形
    function px(x, y, w, h, color) {
      ctx.fillStyle = color;
      ctx.fillRect(Math.round(x), Math.round(y), w, h);
    }

    // 绘制像素环境
    function drawScene() {
      // 1. 秋日黄昏渐变天空（像素阶梯色）
      px(0, 0, 320, 25, '#2b334a');
      px(0, 25, 320, 30, '#424559');
      px(0, 55, 320, 35, '#6d5854');
      px(0, 90, 320, 30, '#946851');
      px(0, 120, 320, 20, '#ba8358');

      // 远景莱顿尖顶与老楼剪影
      px(20, 75, 25, 45, '#221e28');
      px(28, 60, 9, 15, '#221e28');
      px(32, 50, 1, 10, '#221e28');

      px(70, 82, 35, 38, '#26202c');
      px(140, 70, 30, 50, '#221e28');
      px(150, 55, 10, 15, '#221e28');

      // 运河水面 (深蓝黑 + 水波倒影)
      px(0, 138, 320, 42, '#18242b');
      // 水面反光
      const t = Date.now() * 0.002;
      for (let y = 142; y < 180; y += 4) {
        let waveX = (Math.sin(t + y) * 20 + 160) % 320;
        px(waveX, y, 22, 1, '#2c434f');
        px((waveX + 110) % 320, y + 2, 16, 1, '#3b5866');
      }

      // 岸边石阶地面 (加宽地面，让岸边更开阔)
      px(0, 118, 320, 22, '#38363c');
      px(0, 139, 320, 2, '#1c1b1f'); // 石阶边缘深色阴影
      for (let s = 0; s < 320; s += 16) {
        px(s, 119, 1, 20, '#27262b');
        px(s + 2, 120, 6, 1, '#4e4c54');
        px(s + 8, 128, 5, 1, '#47454d');
      }

      // 飘落的秋叶
      leaves.forEach(l => {
        l.y += l.speed;
        l.x += Math.sin(l.sway += 0.04) * 0.5;
        if (l.y > 136) {
          l.y = 10;
          l.x = Math.random() * 320;
        }
        px(l.x, l.y, 2, 2, l.color);
      });

      // 运河边的木制长椅（稳稳安放在石阶人行道上）
      const bx = bench.x;
      const by = bench.y;
      // 椅背
      px(bx - 4, by + 1, 46, 3, '#5c3a21');
      px(bx - 4, by + 5, 46, 2, '#452b19');
      // 椅座
      px(bx - 6, by + 9, 50, 3, '#6e4527');
      px(bx - 6, by + 12, 50, 2, '#3b2212');
      // 铸铁椅腿（稳稳立在石板上）
      px(bx - 3, by + 12, 2, 7, '#1a191b');
      px(bx + 39, by + 12, 2, 7, '#1a191b');

      // 绘制赫尔曼像素人偶
      drawPixelHerman(bx + 18, by + 1);
    }

    // 赫尔曼 16-bit 像素形象
    function drawPixelHerman(hx, hy) {
      ctx.save();
      const shake = scratchEffect > 0 ? (Math.random() - 0.5) * 5 : 0;
      ctx.translate(shake, 0);

      // --- 1. 身体与外套 (深棕外袍 + 细条纹) ---
      px(hx - 7, hy - 2, 14, 13, '#3d2b20'); // 外袍基底
      // 细竖条纹
      px(hx - 5, hy - 1, 1, 11, '#543b2c');
      px(hx - 1, hy - 1, 1, 11, '#543b2c');
      px(hx + 3, hy - 1, 1, 11, '#543b2c');

      // --- 2. 苔绿大翻领 ---
      px(hx - 7, hy - 2, 3, 7, '#384d2b');
      px(hx - 5, hy + 2, 2, 4, '#2d3e23');
      px(hx + 4, hy - 2, 3, 7, '#384d2b');
      px(hx + 3, hy + 2, 2, 4, '#2d3e23');

      // --- 3. 绯红/红棕马甲与纽扣 ---
      px(hx - 3, hy + 2, 6, 9, '#632522');
      // 双排纽扣
      px(hx - 2, hy + 4, 1, 1, '#24100f');
      px(hx + 1, hy + 4, 1, 1, '#24100f');
      px(hx - 2, hy + 7, 1, 1, '#24100f');
      px(hx + 1, hy + 7, 1, 1, '#24100f');

      // --- 4. 白色蓬松褶皱领巾 (Jabot) ---
      px(hx - 3, hy - 3, 6, 4, '#f2ece4');
      px(hx - 2, hy + 1, 4, 2, '#d8cfc4');
      px(hx - 1, hy + 3, 2, 1, '#bfb4a7');

      // --- 5. 领巾中心祖母绿宝石 ---
      px(hx - 1, hy - 2, 2, 2, '#1a7541');
      px(hx, hy - 2, 1, 1, '#79e89d'); // 宝石微光

      // --- 6. 脸部肤色 ---
      px(hx - 4, hy - 11, 8, 8, '#f4cfb2');
      px(hx - 3, hy - 4, 6, 2, '#deb294'); // 下颌阴影

      // --- 7. 赫尔曼标志性绿色眼睛 (深绿瞳孔+亮绿微光) ---
      px(hx - 3, hy - 8, 2, 2, '#206b3a');
      px(hx + 1, hy - 8, 2, 2, '#206b3a');
      px(hx - 2, hy - 8, 1, 1, '#53cf83');
      px(hx + 2, hy - 8, 1, 1, '#53cf83');

      // --- 8. 赫尔曼经典发型：服帖的层次短发 + 标志性中分微翘 M 型刘海 ---
      // 头顶短发与后脑
      px(hx - 5, hy - 13, 10, 4, '#4a2c1b');
      px(hx - 4, hy - 14, 8, 2, '#5e3923'); // 顶发高光
      // 头部两侧贴合修剪的鬓角短发（不再外翻像帽子）
      px(hx - 5, hy - 9, 2, 4, '#4a2c1b');
      px(hx + 3, hy - 9, 2, 4, '#4a2c1b');
      px(hx - 6, hy - 8, 1, 2, '#382012'); // 耳际收窄阴影
      px(hx + 5, hy - 8, 1, 2, '#382012');

      // 赫尔曼标志性【M型额前分刘海】：中间露出额头，两侧弧形垂落微翘
      px(hx - 4, hy - 11, 2, 2, '#4a2c1b');
      px(hx - 3, hy - 9, 1, 2, '#4a2c1b'); // 左边下垂刘海
      px(hx + 2, hy - 9, 1, 2, '#4a2c1b'); // 右边下垂刘海
      px(hx + 3, hy - 11, 2, 2, '#4a2c1b');
      // 中间留白形成经典 M 字分缝 (hy-10 位置露肤色)

      // --- 9. 手里捧着的厚厚研究图纸/手稿 ---
      px(hx + 4, hy + 1, 5, 8, '#f5f0e1');
      px(hx + 5, hy + 2, 3, 6, '#e0d8c3');
      px(hx + 5, hy + 4, 2, 1, '#8f8373'); // 图纸线条

      // --- 10. 赫尔曼头顶 HP 像素血条 ---
      const barW = 32;
      const barH = 4;
      const barX = hx - barW / 2;
      const barY = hy - 21;

      // 边框黑底
      px(barX - 1, barY - 1, barW + 2, barH + 2, '#000000');
      // 底槽
      px(barX, barY, barW, barH, '#331111');
      // 血量占比
      const hpPct = Math.max(0, bench.hp / bench.maxHp);
      const fillW = Math.round(barW * hpPct);
      let hpColor = hpPct > 0.5 ? '#4cd964' : (hpPct > 0.2 ? '#ffcc00' : '#ff3b30');
      if (fillW > 0) px(barX, barY, fillW, barH, hpColor);

      // HP 数字：彻底取消模糊描边，直接清晰纯白像素硬字输出！
      ctx.font = '8px monospace';
      ctx.fillStyle = '#ffefd5';
      ctx.textAlign = 'center';
      ctx.fillText(`${bench.hp}/${bench.maxHp}`, hx, barY - 3);

      // --- 11. 抓痕红色特效 ---
      if (scratchEffect > 0) {
        const sx = hx - 4;
        const sy = hy - 4;
        px(sx - 3, sy - 3, 2, 2, '#ff3b30');
        px(sx - 1, sy - 1, 2, 2, '#ff6961');
        px(sx + 1, sy + 1, 2, 2, '#ffffff');

        px(sx + 3, sy - 2, 2, 2, '#ff3b30');
        px(sx + 5, sy, 2, 2, '#ff6961');
        px(sx + 7, sy + 2, 2, 2, '#ffffff');
        scratchEffect--;
      }

      ctx.restore();
    }

    // 小白猫高精度 16-bit 像素逐帧（重塑真正可爱的猫猫轮廓，宽萌三角耳，拒绝兔耳）
    function drawPixelCat(x, y, facing, frame) {
      ctx.save();
      ctx.translate(Math.round(x), Math.round(y));
      ctx.scale(facing, 1);

      const anim = Math.floor(frame / 6) % 4; // 4帧步态
      const bob = (anim === 1 || anim === 3) ? -1 : 0;

      // 1. 蓬松微翘的长猫尾巴 (柔和弧线)
      const tailW = Math.sin(frame * 0.25) > 0 ? 1 : 0;
      px(-12, -7 + bob - tailW, 3, 2, '#ffffff');
      px(-14, -10 + bob - tailW, 3, 3, '#ffffff');
      px(-13, -13 + bob, 3, 3, '#ffffff');
      px(-10, -15 + bob, 3, 2, '#ebebf0');

      // 2. 猫猫圆润柔韧的身躯 (宽长协调)
      px(-10, -8 + bob, 15, 6, '#ffffff');
      px(-8, -9 + bob, 12, 1, '#ffffff');
      px(-9, -2 + bob, 14, 1, '#d8d8e3'); // 腹部阴影

      // 3. 稳健可爱的小爪子 (小肉掌，4帧踏步)
      if (anim === 0) {
        px(-8, -1, 3, 3, '#dedee6');
        px(-3, -1, 3, 2, '#ffffff');
        px(1, -1, 3, 3, '#dedee6');
        px(4, -1, 3, 2, '#ffffff');
      } else if (anim === 1) {
        px(-9, -2, 3, 3, '#dedee6');
        px(-2, -1, 3, 3, '#ffffff');
        px(0, -2, 3, 3, '#dedee6');
        px(4, 0, 3, 2, '#ffffff');
      } else if (anim === 2) {
        px(-7, -1, 3, 3, '#dedee6');
        px(-4, -1, 3, 2, '#ffffff');
        px(2, -1, 3, 3, '#dedee6');
        px(3, -1, 3, 2, '#ffffff');
      } else {
        px(-8, -2, 3, 3, '#dedee6');
        px(-3, 0, 3, 2, '#ffffff');
        px(1, -2, 3, 3, '#dedee6');
        px(3, -1, 3, 3, '#ffffff');
      }

      // 4. 猫猫圆脸庞与脸颊软毛 (圆润猫脸，比例协调)
      const hx = 2;
      const hy = -12 + bob;
      px(hx, hy - 1, 8, 7, '#ffffff');     // 主脸部
      px(hx - 1, hy + 1, 10, 4, '#ffffff'); // 鼓鼓的软腮肉
      px(hx + 8, hy + 2, 2, 3, '#ffffff');  // 微突的吻部

      // 5. 经典【宽底短三角形】猫耳（彻底告别细长兔子耳！）
      // 左耳（外侧宽底三角）
      px(hx + 1, hy - 3, 3, 2, '#ffffff');
      px(hx + 1, hy - 2, 2, 1, '#fba4af');
      px(hx + 2, hy - 4, 1, 1, '#ffffff');
      // 右耳（外侧宽底三角）
      px(hx + 5, hy - 3, 3, 2, '#ffffff');
      px(hx + 6, hy - 2, 2, 1, '#fba4af');
      px(hx + 6, hy - 4, 1, 1, '#ffffff');

      // 6. 晶莹剔透的水灵大眼（蔚蓝猫瞳）
      px(hx + 4, hy + 1, 3, 3, '#2563eb');
      px(hx + 4, hy + 1, 1, 1, '#bfdbfe'); // 灵动瞳孔反光

      // 7. 肉粉色的小鼻头与嘴角微翘
      px(hx + 8, hy + 3, 2, 1, '#fb7185');
      px(hx + 7, hy + 4, 2, 1, '#e2e8f0'); // 下巴

      ctx.restore();
    }

    function showDialog(text) {
      dialog.innerText = text;
      dialog.classList.add('show');
      clearTimeout(window.dialogTimer);
      window.dialogTimer = setTimeout(() => {
        dialog.classList.remove('show');
      }, 5500);
    }

    function interact() {
      const dist = Math.abs(cat.x - (bench.x + 18));
      if (dist < 45) {
        showDialog(dialogues[dialogIndex % dialogues.length]);
        dialogIndex++;
      } else {
        showDialog("小猫在莱顿运河畔伸了伸懒腰，打了个哈欠~ 走近长椅看看？");
      }
    }

    function scratchHerman() {
      const dist = Math.abs(cat.x - (bench.x + 18));
      if (dist < 50) {
        scratchEffect = 18; // 像素震颤与红爪火花
        
        const damage = Math.floor(Math.random() * 8) + 14;
        bench.hp = Math.max(0, bench.hp - damage);

        if (bench.hp === 0) {
          showDialog(`【像素暴击！-${damage} HP】赫尔曼血条被打空！他瘫在长椅上挥着白手帕：『投降了……阿尔瓦，今晚永动轮的代码你自己写去吧，我休假了……』`);
          setTimeout(() => {
            bench.hp = bench.maxHp;
            showDialog("（赫尔曼吃了块阿尔瓦递过来的热华夫饼，哼了一声，像素血条又回满了！）");
          }, 4500);
        } else {
          const baseText = scratchDialogues[scratchIndex % scratchDialogues.length];
          showDialog(`【暴击！-${damage} HP】` + baseText);
          scratchIndex++;
        }
      } else {
        showDialog("隔太远啦！小猫在风中挥了挥粉肉垫——走近长椅再给他一爪子！");
      }
    }

    // 控制与事件
    const keys = {};
    window.addEventListener('keydown', e => {
      keys[e.key] = true;
      if (e.key === ' ' || e.key === 'Enter') interact();
      if (e.key === 'f' || e.key === 'F' || e.key === 'x' || e.key === 'X') scratchHerman();
    });
    window.addEventListener('keyup', e => {
      keys[e.key] = false;
    });

    const btnLeft = document.getElementById('btnLeft');
    const btnRight = document.getElementById('btnRight');
    const btnAction = document.getElementById('btnAction');
    const btnScratch = document.getElementById('btnScratch');

    let touchLeft = false, touchRight = false;
    btnLeft.addEventListener('pointerdown', (e) => { e.preventDefault(); touchLeft = true; });
    window.addEventListener('pointerup', () => { touchLeft = false; touchRight = false; });
    btnRight.addEventListener('pointerdown', (e) => { e.preventDefault(); touchRight = true; });
    btnAction.addEventListener('click', interact);
    btnScratch.addEventListener('click', scratchHerman);

    function gameLoop() {
      cat.vx = 0;
      if (keys['ArrowLeft'] || keys['a'] || touchLeft) {
        cat.vx = -cat.speed;
        cat.facing = -1;
      }
      if (keys['ArrowRight'] || keys['d'] || touchRight) {
        cat.vx = cat.speed;
        cat.facing = 1;
      }

      cat.x += cat.vx;
      if (cat.x < 15) cat.x = 15;
      if (cat.x > 305) cat.x = 305;

      if (cat.vx !== 0) {
        cat.walkTimer += 1;
      } else {
        cat.walkTimer = 0;
      }

      ctx.clearRect(0, 0, canvas.width, canvas.height);
      drawScene();
      drawPixelCat(cat.x, cat.y, cat.facing, cat.walkTimer);

      requestAnimationFrame(gameLoop);
    }

    gameLoop();
  </script>
</body>
</html>
